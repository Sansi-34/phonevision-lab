# ============================================================
# PhoneVision Lab — .gitattributes
# 统一文本换行符与二进制标记（仅添加规则，不重写现有文件）
# ============================================================

* text=auto

# 源码文本统一 LF（跨平台一致）
*.kt text eol=lf
*.kts text eol=lf
*.xml text eol=lf
*.py text eol=lf
*.md text eol=lf
*.qss text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf

# Windows 批处理与 Gradle Wrapper
*.bat text eol=crlf
gradlew text eol=lf

# 二进制文件（不做文本转换）
*.png binary
*.jpg binary
*.jpeg binary
*.jar binary
*.apk binary
*.mjpeg binary
*.zip binary
