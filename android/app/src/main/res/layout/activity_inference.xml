<?xml version="1.0" encoding="utf-8"?>
<!--
  PhoneVision Lab — 本机 AI 推理界面布局（V0-B）
  职责：摄像头预览 + 模型/预测/性能信息 + 推理控制 + 硬件联动面板。
  为什么这样设计：
    - 预览占主要空间，信息区用等宽字体显示可测量的数字（帧率、耗时）。
    - 硬件联动面板默认折叠区域独立：没有接硬件时不影响采集与推理。
  初学者调试观察点：预测不变先看"推理帧率"是否为 0，是 0 说明推理线程没跑。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/inferenceScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/inferTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="本机 AI 推理"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextureView
        android:id="@+id/inferPreview"
        android:layout_width="match_parent"
        android:layout_height="240dp"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/inferStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="monospace"
        android:lineSpacingExtra="3dp"
        android:textSize="13sp"
        android:text="未导入模型" />

    <!-- 模型导入 -->
    <Button
        android:id="@+id/importModelButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="导入模型包 (.pvlmodel.zip)" />

    <!-- 导入进度：解压/校验/Interpreter 构造在后台线程执行，这里只显示"进行中" -->
    <ProgressBar
        android:id="@+id/importProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:indeterminate="true"
        android:visibility="gone" />

    <!-- 推理控制 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/startInferButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:enabled="false"
            android:text="开始推理" />

        <Button
            android:id="@+id/stopInferButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:enabled="false"
            android:text="停止推理" />
    </LinearLayout>

    <!-- 硬件联动 -->
    <TextView
        android:id="@+id/hardwareTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="硬件联动（可选）"
        android:textSize="16sp"
        android:textStyle="bold" />

    <Spinner
        android:id="@+id/targetClassSpinner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:contentDescription="自动控制目标类别" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/deviceHostInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:hint="控制器 IP"
            android:inputType="text"
            android:importantForAutofill="no" />

        <Button
            android:id="@+id/connectDeviceButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="连接" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/testLedOnButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:enabled="false"
            android:text="手动 LED 开" />

        <Button
            android:id="@+id/testLedOffButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:enabled="false"
            android:text="手动 LED 关" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/autoControlButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:enabled="false"
            android:text="开启自动控制（默认关）" />

        <Button
            android:id="@+id/stopControlButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:enabled="false"
            android:text="停止控制" />
    </LinearLayout>

    <TextView
        android:id="@+id/eventLog"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_marginTop="8dp"
        android:background="#11000000"
        android:fontFamily="monospace"
        android:gravity="bottom"
        android:padding="6dp"
        android:scrollbars="vertical"
        android:textSize="11sp"
        android:text="" />

</LinearLayout>
</ScrollView>
