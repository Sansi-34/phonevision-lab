/* ============================================================
   PhoneVision Lab — 深色产品级主题 (PySide6 QSS)
   加载：app.setStyleSheet(Path("style.qss").read_text(encoding="utf-8"))

   设计 Token（全文件统一，不重复硬编码）：
     - bg      #0E1116  窗口底
     - panel   #161B26  面板/卡片底
     - topbar  #10141D  顶栏/侧栏底
     - video   #000000  画面区
     - line    #232A39  分隔/描边
     - brand   #5B7CFA  品牌强调色（唯一强调，仅选中/主按钮/已滑轨道）
     - text    #E6EAF2  主文本
     - muted   #8A93A6  次文本
     - success #3DD68C  状态绿
     - warning #F5A524  状态琥珀
     - error   #F2645F  状态红

   设计要点：
     - 层级靠"亮度 + 留白"，不用重边框
     - 状态色只表状态，不混入品牌强调
     - 无渐变、无霓虹、无无意义阴影
     - 数据数字等宽（Consolas）
     - 圆角有层级：顶栏(6) < 面板/按钮(8) < 卡片(10-12)
   ============================================================ */

/* ---------- 基础 ---------- */
QMainWindow, QDialog {
    background-color: #0E1116;
    color: #E6EAF2;
}
QWidget {
    /* 中文字体优先回退（Segoe UI 无中文字形，若系统无 YaHei 会显示方框字）；
       实际字形由 fonts.py 的 QApplication 全局字体兜底，此处提供候选列表 */
    font-family: "Microsoft YaHei UI", "Microsoft YaHei", "Segoe UI";
    font-size: 9pt;
    color: #E6EAF2;
    /* 注意：不写 background，QLabel 等默认透明，透出父级背景 */
}

/* ---------- 顶栏 ---------- */
#topbar {
    background-color: #10141D;
    border: 1px solid #232A39;
    border-radius: 6px;
}
#brandLabel {
    color: #E6EAF2;
    font-size: 11pt;
    font-weight: 700;
    letter-spacing: 1px;
}
#deviceLabel {
    color: #8A93A6;
    font-size: 9pt;
    max-width: 220px;
}
#languageSelector {
    color: #E6EAF2;
    background-color: #1A2029;
    border: 1px solid #232A39;
    border-radius: 6px;
    padding: 3px 8px;
    min-width: 92px;
}
#saveButton {
    font-weight: 600;
}
#reconnectButton {
    font-weight: 500;
}
QLabel[textRole="muted"] { color: #4A5260; }

/* ---------- 右侧检查器 ---------- */
QFrame#inspector {
    background-color: #10141D;
    border: 1px solid #232A39;
    border-radius: 10px;
}

/* ---------- 卡片 ---------- */
QFrame[cardRole="card"] {
    background-color: #161B26;
    border: 1px solid #232A39;
    border-radius: 10px;
}
QFrame[cardRole="card"]:hover { border-color: #2A3140; }

/* ---------- 文本 ---------- */
QLabel[textRole="groupTitle"] {
    color: #E6EAF2;
    font-size: 9.5pt;
    font-weight: 600;
}
QLabel[textRole="caption"] {
    color: #8A93A6;
    font-size: 8pt;
}
QLabel[textRole="hint"] {
    color: #4A5260;
    font-size: 8pt;
}
QLabel[textRole="hint"][hintRole="active"] {
    color: #8A93A6;
}
QLabel[textRole="hint"][hintRole="empty"] {
    color: #4A5260;
    font-style: italic;
}

/* ---------- 通用按钮（四态齐全） ---------- */
QPushButton {
    background-color: #1A2029;
    color: #D7DDEA;
    border: 1px solid transparent;
    border-radius: 8px;
    padding: 5px 14px;
    font-weight: 500;
    min-height: 32px;
}
QPushButton:hover  { background-color: #232B3A; }
QPushButton:pressed { background-color: #2A3140; }
QPushButton:disabled {
    color: #5C6470;
    background-color: #141924;
}
QPushButton:focus {
    border: 1px solid #5B7CFA;
    outline: none;
}

/* 品牌主按钮 */
QPushButton[buttonRole="primary"] {
    background-color: #5B7CFA;
    color: #FFFFFF;
    border: none;
    font-weight: 600;
}
QPushButton[buttonRole="primary"]:hover  { background-color: #7B95FF; }
QPushButton[buttonRole="primary"]:pressed { background-color: #4657D6; }
QPushButton[buttonRole="primary"]:disabled {
    background-color: rgba(91, 124, 250, 0.20);
    color: rgba(230, 234, 242, 0.45);
}

/* 幽灵/次按钮 */
QPushButton[buttonRole="ghost"] {
    background-color: transparent;
    color: #9AA3B2;
    border: 1px solid #2A3140;
}
QPushButton[buttonRole="ghost"]:hover {
    background-color: #1B2131;
    border-color: #35405A;
    color: #E6EAF2;
}
QPushButton[buttonRole="ghost"]:pressed { background-color: #232B3A; }
QPushButton[buttonRole="ghost"]:disabled {
    color: #5C6470;
    border-color: #1E2430;
    background-color: transparent;
}

/* ---------- 模式按钮（纵向紧凑，checkable，:checked 变主色） ---------- */
QPushButton#modeButton {
    background-color: #1A2029;
    color: #9AA3B2;
    border: 1px solid transparent;
    border-radius: 8px;
    padding: 5px 0;
    font-weight: 500;
    text-align: left;
    padding-left: 12px;
}
QPushButton#modeButton:hover {
    background-color: #232B3A;
    color: #E6EAF2;
}
QPushButton#modeButton:checked {
    background-color: rgba(91, 124, 250, 0.18);
    color: #5B7CFA;
    border: 1px solid rgba(91, 124, 250, 0.45);
    font-weight: 600;
}
QPushButton#modeButton:checked:hover {
    background-color: rgba(91, 124, 250, 0.26);
    color: #7B95FF;
}
QPushButton#modeButton:pressed { background-color: #2A3140; }

/* ---------- 滑块 QSlider（Windows 完整可用写法） ---------- */
QSlider { min-height: 24px; }

QSlider::groove:horizontal {
    height: 4px;
    background: #232A38;
    border-radius: 2px;
}
QSlider::sub-page:horizontal {
    background: #5B7CFA;
    border-radius: 2px;
}
QSlider::sub-page:horizontal:hover { background: #7B95FF; }
QSlider::add-page:horizontal {
    background: #232A38;
    border-radius: 2px;
}
QSlider::handle:horizontal {
    width: 16px;
    height: 16px;
    margin: -6px 0;
    background: #E6EAF2;
    border-radius: 8px;
}
QSlider::handle:horizontal:hover   { background: #FFFFFF; }
QSlider::handle:horizontal:pressed { background: #5B7CFA; }
QSlider::handle:horizontal:focus { border: 2px solid #5B7CFA; }

QLabel#sliderValue {
    color: #E6EAF2;
    font-family: "Consolas";
    font-size: 9pt;
    font-weight: 600;
}

/* ---------- 滚动区 ---------- */
QScrollArea {
    border: none;
    background: transparent;
}
/* viewport 必须吃深色主题，否则参数卡渲染成白底 */
QScrollArea > QWidget > QWidget {
    background: #161B26;
}
QScrollArea QWidget#qt_scrollarea_viewport {
    background: #161B26;
}

/* ---------- 滚动条 ---------- */
QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 2px;
}
QScrollBar::handle:vertical {
    background: #3A4457;
    border-radius: 3px;
    min-height: 30px;
}
QScrollBar::handle:vertical:hover { background: #4A5468; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical,  QScrollBar::sub-page:vertical  { background: transparent; }

QScrollBar:horizontal {
    background: transparent;
    height: 8px;
    margin: 2px;
}
QScrollBar::handle:horizontal {
    background: #3A4457;
    border-radius: 3px;
    min-width: 30px;
}
QScrollBar::handle:horizontal:hover { background: #4A5468; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }
QScrollBar::add-page:horizontal,  QScrollBar::sub-page:horizontal  { background: transparent; }

/* ---------- Tooltip ---------- */
QToolTip {
    background-color: #1B2131;
    color: #E6EAF2;
    border: 1px solid #2A3140;
    padding: 4px 8px;
    border-radius: 6px;
}

/* ============================================================
   ui_components（StatusPill / ToastBanner / VideoView / DiagnosticsPanel）
   这些组件由 ui_components.py 创建，这里只负责外观。
   ============================================================ */

/* ---------- StatusPill（状态灯：圆点 + 状态文本） ---------- */
#statusPill {
    background-color: #1A2029;
    border: 1px solid #232A39;
    border-radius: 10px;
    padding: 2px 8px;
}
/* 圆点：组件用 statusRole="dot" + chipState 上色 */
QLabel[statusRole="dot"] {
    min-width: 8px;
    max-width: 8px;
    min-height: 8px;
    max-height: 8px;
    border-radius: 4px;
    background-color: #5C6470;
}
QLabel[statusRole="dot"][chipState="success"] { background-color: #3DD68C; }
QLabel[statusRole="dot"][chipState="warning"] { background-color: #F5A524; }
QLabel[statusRole="dot"][chipState="error"]   { background-color: #F2645F; }
QLabel[statusRole="dot"][chipState="idle"]    { background-color: #5C6470; }
/* 状态文本：组件用 textRole="chipValue" + chipState 上色 */
QLabel[textRole="chipValue"][chipState="success"] { color: #3DD68C; }
QLabel[textRole="chipValue"][chipState="warning"] { color: #F5A524; }
QLabel[textRole="chipValue"][chipState="error"]   { color: #F2645F; }
QLabel[textRole="chipValue"][chipState="idle"]    { color: #8A93A6; }

/* ---------- ToastBanner（toastRole 分色底） ---------- */
#toastBanner {
    background-color: #1B2131;
    border: 1px solid #2A3140;
    border-radius: 8px;
    padding: 2px;
}
#toastBanner[toastRole="success"] { background-color: rgba(61, 214, 140, 0.12); border-color: rgba(61, 214, 140, 0.45); }
#toastBanner[toastRole="info"]    { background-color: rgba(91, 124, 250, 0.12); border-color: rgba(91, 124, 250, 0.45); }
#toastBanner[toastRole="warning"] { background-color: rgba(245, 165, 36, 0.12); border-color: rgba(245, 165, 36, 0.45); }
#toastBanner[toastRole="error"]   { background-color: rgba(242, 100, 95, 0.12); border-color: rgba(242, 100, 95, 0.45); }
QLabel#toastText {
    color: #E6EAF2;
    font-size: 9pt;
    padding: 2px 8px;
}

/* ---------- VideoView（画面区：纯黑底 + 居中信息） ---------- */
#videoView {
    background-color: #000000;
    border: 1px solid #232A39;
    border-radius: 10px;
}
QLabel#videoInfo {
    color: #8A93A6;
    font-size: 8pt;
    font-family: "Consolas";
    background-color: rgba(0, 0, 0, 0.55);
    border-radius: 4px;
    padding: 2px 6px;
}

/* ---------- DiagnosticsPanel（底部诊断区） ---------- */
#diagnosticsPanel {
    background-color: #10141D;
    border: 1px solid #232A39;
    border-radius: 10px;
}
#diagnosticsToggleButton {
    background-color: transparent;
    border: none;
    color: #8A93A6;
    font-weight: 600;
    text-align: left;
    padding: 2px 4px;
}
#diagnosticsToggleButton:hover { color: #E6EAF2; }
QFrame#diagnosticsGrid {
    background-color: transparent;
    border: none;
    border-radius: 0;
}
QLabel[textRole="diagLabel"] {
    color: #5C6470;
    font-size: 8pt;
}
QLabel[textRole="diagValue"] {
    color: #E6EAF2;
    font-family: "Consolas";
    font-size: 10pt;
    font-weight: 600;
}
QLabel[textRole="diagValue"][diagState="success"] { color: #3DD68C; }
QLabel[textRole="diagValue"][diagState="warning"] { color: #F5A524; }
QLabel[textRole="diagValue"][diagState="error"]   { color: #F2645F; }
